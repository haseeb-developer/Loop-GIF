# Copy to .env and edit. Generate a secret: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_USER=loop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loop

SECRET_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false            # true on HTTPS (always true in production)
TRUST_PROXY=false              # true only behind a proxy you control (needed for correct per-IP rate limits)

# Where the web app lives. Comma separated; used for CORS and the CSRF origin check.
CORS_ORIGINS=http://localhost:3000
# Optional: also allow Vercel preview deployments
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Origin that serves /g/<name>.gif in the links users copy.
#   Local:      http://localhost:8000  (direct to the API)
#   Production: your API origin (cheapest: GIF bytes skip Vercel) or your Vercel domain (prettier, proxied)
PUBLIC_BASE_URL=http://localhost:8000
# Origin the browser uploads video chunks to. MUST be the API itself, not the Vercel domain.
# Leave empty to use PUBLIC_BASE_URL.
UPLOAD_BASE_URL=
# Web app origin: /g/<name> on the API redirects to the share page here
WEB_BASE_URL=http://localhost:3000

# Build/runtime for the web app (docker compose). On Vercel set API_ORIGIN in the project settings instead.
API_ORIGIN=http://api:8000

# Optional limits (defaults shown)
# MAX_UPLOAD_MB=2048
# MAX_INPUT_DURATION_S=0          # 0 = unlimited
# MAX_CLIP_S=60
# MAX_OUTPUT_WIDTH=1280
# MAX_GIF_MB=125
# CONVERSION_CONCURRENCY=2
# MAX_SOURCE_STORAGE_MB_PER_USER=8192
# SOURCE_RETENTION_HOURS=72
